# YARN Scheduler UI - Environment Configuration
# Copy this file to .env and adjust values for your local environment

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Base ResourceManager endpoint (optional; defaults to /ws/v1/cluster relative to the origin)
# Uncomment and set if your ResourceManager is on a different host
# VITE_YARN_API_URL=http://rm-host:8088/ws/v1/cluster

# -----------------------------------------------------------------------------
# Mock Service Configuration
# -----------------------------------------------------------------------------

# Mock service mode controls how the UI handles API requests:
#   static  - Serves JSON fixtures from public/mock/ws/v1/cluster via MSW (default in dev)
#   cluster - Proxies browser requests to the configured cluster target
#   off     - Disables the mock service worker entirely
VITE_API_MOCK_MODE=static

# Cluster proxy configuration (required when VITE_API_MOCK_MODE=cluster)
# These settings enable the dev server to proxy requests to a real YARN cluster
# VITE_CLUSTER_PROXY_TARGET=http://rm-host:8088
# VITE_MOCK_CLUSTER_URL=/ws/v1/cluster

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Username used for simple-authenticated clusters
# This is injected into API requests when YARN is configured with simple auth
VITE_YARN_USER_NAME=yarn
